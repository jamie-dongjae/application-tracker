 "prep": [
  {
   "id": 1,
   "category": "Behavioral",
   "question": "Tell me about a time you resolved a conflict in a team.",
   "answer": "Two analysts disagreed on metric definitions mid-sprint. I facilitated a working session, wrote the definition doc, and got both to co-own it. The review shipped on time and the doc became the team standard. Tips: name the disagreement neutrally; focus on the process."
  },
  {
   "id": 2,
   "category": "Behavioral",
   "question": "Describe a project you drove end to end.",
   "answer": "A churn dashboard leadership wanted but nobody owned. Scoped it with stakeholders, built the pipeline, automated QA checks. Adopted in the weekly business review and it caught a billing bug. Tips: quantify the result."
  },
  {
   "id": 3,
   "category": "Behavioral",
   "question": "Tell me about a time you missed a deadline.",
   "answer": "Underestimated a migration during a dashboard rebuild. Flagged it early, cut scope with the stakeholder, delivered the core a week late. Trust preserved; the process now includes a migration checklist. Tips: own it \u2014 no blame-shifting."
  },
  {
   "id": 4,
   "category": "Technical",
   "question": "How would you find duplicate users in a table?",
   "answer": "GROUP BY email HAVING COUNT(*) > 1, or ROW_NUMBER() over a window to keep the first occurrence. Tips: mention the trade-offs between the two."
  },
  {
   "id": 5,
   "category": "Technical",
   "question": "Explain p-values to a non-technical stakeholder.",
   "answer": "The probability of seeing data this extreme if there were truly no effect. Tips: avoid saying 'probability the hypothesis is true'."
  },
  {
   "id": 6,
   "category": "Case",
   "question": "Signups dropped 15% week over week \u2014 walk me through your investigation.",
   "answer": "Segment by platform, geo, and channel; check tracking changes, seasonality, and funnel step deltas before hypothesizing. Tips: structure first, hypotheses second."
  },
  {
   "id": 7,
   "category": "Motivation",
   "question": "Why this company?",
   "answer": "Tie one product decision they made to your own experience; be specific. Tips: research one recent launch."
  },
  {
   "id": 8,
   "category": "Motivation",
   "question": "Where do you see yourself in five years?",
   "answer": "Growing from IC excellence toward owning a problem space. Tips: keep it honest, not rehearsed."
  }
