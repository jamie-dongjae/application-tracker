  {
   "id": 1,
   "category": "Behavioral",
   "subcategory": "Teamwork",
   "question": "Tell me about a time you resolved a conflict in a team.",
   "situation": "Two analysts disagreed on metric definitions mid-sprint.",
   "task": "Align the team before the stakeholder review.",
   "action": "Facilitated a working session, wrote the definition doc, got both to co-own it.",
   "result": "Review shipped on time; the doc became the team standard.",
   "tips": "Name the disagreement neutrally; focus on the process."
  },
  {
   "id": 2,
   "category": "Behavioral",
   "subcategory": "Ownership",
   "question": "Describe a project you drove end to end.",
   "situation": "Churn dashboard requested by leadership with no clear owner.",
   "task": "Deliver a trustworthy weekly view of churn drivers.",
   "action": "Scoped with stakeholders, built the pipeline, automated QA checks.",
   "result": "Adopted in the weekly business review; caught a billing bug.",
   "tips": "Quantify the result."
  },
  {
   "id": 3,
   "category": "Technical",
   "subcategory": "SQL",
   "question": "How would you find duplicate users in a table?",
   "situation": "",
   "task": "",
   "action": "GROUP BY email HAVING COUNT(*) > 1, or ROW_NUMBER() OVER a window to keep the first.",
   "result": "",
   "tips": "Mention trade-offs between the two."
  },
  {
   "id": 4,
   "category": "Technical",
   "subcategory": "Statistics",
   "question": "Explain p-values to a non-technical stakeholder.",
   "situation": "",
   "task": "",
   "action": "Probability of seeing data this extreme if there were truly no effect.",
   "result": "",
   "tips": "Avoid 'probability the hypothesis is true'."
  },
  {
   "id": 5,
   "category": "Case",
   "subcategory": "Metrics",
   "question": "Signups dropped 15% week over week \u2014 walk me through your investigation.",
   "situation": "",
   "task": "",
   "action": "Segment (platform, geo, channel), check tracking changes, seasonality, funnel step deltas.",
   "result": "",
   "tips": "Structure first, hypotheses second."
  },
